{
  "name": "spinsmith",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "env -u WAYLAND_DISPLAY XDG_SESSION_TYPE=x11 __NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia __VK_LAYER_NV_optimus=NVIDIA_only DRI_PRIME=1 iwsdk dev restart --open --foreground",
    "dev:runtime": "env -u WAYLAND_DISPLAY XDG_SESSION_TYPE=x11 __NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia __VK_LAYER_NV_optimus=NVIDIA_only DRI_PRIME=1 vite",
    "dev:down": "iwsdk dev down",
    "dev:status": "iwsdk dev status",
    "reference:status": "iwsdk reference status",
    "reference:warmup": "iwsdk reference warmup",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "postbuild": "node scripts/clean-dist.mjs && node scripts/check-public-release.mjs",
    "preview": "vite preview",
    "check:sim": "node scripts/sim-check.ts",
    "check:sim-n": "node scripts/sim-n-check.ts",
    "check:net": "node scripts/net-check.ts",
    "check:desk-ko": "bash scripts/check-desk-ko-hand.sh",
    "check:desk-guard": "npx @iwsdk/cli browser run scripts/check-desk-guard-probe.mjs --timeout 60000",
    "report:arenas": "node scripts/arena-report.ts",
    "report:tops": "node scripts/top-report.ts",
    "report:shaping": "node scripts/shaping-report.ts",
    "report:render-budget": "npx @iwsdk/cli browser run scripts/measure-render-budget.mjs --timeout 90000",
    "capture:gameplay": "scripts/trailer.sh",
    "capture:ultimates": "scripts/ultimates.sh",
    "capture:competition": "scripts/competition-trailer.sh",
    "capture:cinematic": "scripts/capture/cinematic.sh",
    "capture:heroes": "scripts/capture/heroes.sh"
  },
  "dependencies": {
    "@iwsdk/core": "1.0.1",
    "@pmndrs/uikit": "^1.0.74",
    "@pmndrs/uikit-horizon": "^1.0.74",
    "@pmndrs/uikit-lucide": "^1.0.74",
    "three": "npm:super-three@0.181.0",
    "trystero": "^0.26.0"
  },
  "devDependencies": {
    "@iwsdk/cli": "1.0.1",
    "@iwsdk/reference": "1.0.1",
    "@iwsdk/vite-plugin-dev": "1.0.1",
    "@meta-quest/metavr": "^1.8.1",
    "@types/three": "^0.181.0",
    "typescript": "^5.5.0",
    "vite": "^7.1.4"
  },
  "overrides": {
    "sharp": "0.35.4",
    "three": "npm:super-three@0.181.0"
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0-0 || >=22.12.0 <23.0.0-0 || >=24.0.0"
  }
}
